# ============================================================
# APP
# ============================================================

APP_HOST=0.0.0.0
APP_PORT=8000

# Используется docker-compose -> uvicorn
UVICORN_WORKERS=4

APP_TIMEOUT=30
APP_RELOAD=false


# ============================================================
# LOGGING
# ============================================================

LOG_LEVEL=INFO
LOG_FORMAT=json
PII_SANITIZATION=true


# ============================================================
# LLM / DEEPSEEK
# ============================================================

LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=ВСТАВЬ_СЮДА_СВОЙ_DEEPSEEK_API_KEY
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=1


# ============================================================
# REDIS
# ============================================================

# ВАЖНО: внутри Docker localhost НЕ используем
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Сгенерируем отдельно
REDIS_PASSWORD=h_sSsB90CjTRNGnXQSF1wJjQ-YnNAgFkvakJnjFraBs

REDIS_MAX_CONNECTIONS=100
REDIS_SOCKET_TIMEOUT=0.2
REDIS_SOCKET_CONNECT_TIMEOUT=0.2


# ============================================================
# PAYLOAD STORE
# ============================================================

# Твой сгенерированный Fernet key:
PAYLOAD_STORE_KEY=bXtQpRT85SdKWH3pnDioE06ayfaVkBO_jJIJyTMROJ0=   

# На сервере fallback запрещён
PAYLOAD_STORE_ALLOW_MEMORY_FALLBACK=false

PAYLOAD_STORE_TTL_SECONDS=3600


# ============================================================
# RATE LIMI
# ============================================================

RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_RPS=1500
RATE_LIMIT_BURST=2000
RATE_LIMIT_KEY_PREFIX=pii_gateway:ratelimit:


# ============================================================
# DETECTOR
# ============================================================

NATASHA_ENABLED=true
NATASHA_CONFIDENCE_THRESHOLD=0.85

PRESIDIO_ENABLED=true
PRESIDIO_CONFIDENCE_THRESHOLD=0.8
PRESIDIO_LANGUAGE=ru

REGEX_ENABLED=true

COMPOSITE_STRATEGY=priority
COMPOSITE_DEDUPLICATE=true
COMPOSITE_MIN_CONFIDENCE=0.75


# ============================================================
# MASKER
# ============================================================

MASKER_TOKEN_PREFIX=[
MASKER_TOKEN_SUFFIX=]
MASKER_TOKEN_FORMAT={type}_{index}
MASKER_PRESERVE_CASE=false
MASKER_PRESERVE_LENGTH=false


# ============================================================
# PIPELINE
# ============================================================

PIPELINE_MAX_TEXT_LENGTH=100000
PIPELINE_MAX_ENTITIES_PER_REQUEST=500
PIPELINE_LLM_TIMEOUT=25
PIPELINE_TOTAL_TIMEOUT=28
